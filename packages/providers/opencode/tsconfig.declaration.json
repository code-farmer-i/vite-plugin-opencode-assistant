{
  // pagoda-cli build 每次会重写本文件：重跑 build 后需重新加回 es/plugins 排除（zod TS2883：内部插件不参与类型声明检查）
  "extends": "../../../tsconfig.base",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": ".",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": ["es/**/*", "lib/**/*"],
  "exclude": ["**/node_modules", "**/test/**/*", "es/plugins/**", "lib/plugins/**"]
}
